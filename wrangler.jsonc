    { "pattern": "ponci.art", "custom_domain": true },
    { "pattern": "www.ponci.art", "custom_domain": true }
  ],
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://wcdetrugbkgmapeehyxg.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_I9Nx_Frq7An3zxhh8kPIJw_q6a5QlqC"
  },
  "observability": { "enabled": true }
}
